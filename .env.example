# Flask 설정
FLASK_ENV=production
SECRET_KEY=hyundai-heavy-industry-modbus-secret-key-2025
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Modbus TCP 설정
MODBUS_HOST=192.168.10.105
MODBUS_PORT=502
MODBUS_UNIT_ID=1
MODBUS_TIMEOUT=0.3

# 폴링 설정 (초 단위)
POLL_INTERVAL=0.5

# DO 출력 자동 꺼짐 시간 (초 단위, 0이면 자동 꺼짐 비활성화)
OUTPUT_AUTO_OFF_TIME=1.0

# DO 출력 제어 실패 시 재시도 설정
OUTPUT_RETRY_COUNT=3
OUTPUT_RETRY_DELAY=0.1

# DI 감지 시 호출할 센서 URL 설정
SENSOR_URL=http://localhost:5000/api/get_sensor
SENSOR_DEVICE_ID=HHI_DEVICE_001

# 로깅 설정
LOG_LEVEL=INFO
