# ==============================================================================
# CIE-H14A Modbus TCP/IP 멀티 제어 시스템 - 환경 설정 예시
# ==============================================================================
#
# 이 파일을 복사하여 .env 파일로 저장한 후 실제 값으로 수정하세요.
# cp .env.example .env
#
# 최대 8대의 장비를 동시에 제어할 수 있습니다.
#
# ==============================================================================

# ==============================================================================
# Flask 설정
# ==============================================================================
FLASK_ENV=production
SECRET_KEY=hyundai-heavy-industry-modbus-secret-key-2025-CHANGE-ME
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ==============================================================================
# 전역 Modbus 기본값 (모든 장비에 공통 적용)
# ==============================================================================
MODBUS_DEFAULT_PORT=502
MODBUS_DEFAULT_UNIT_ID=1
MODBUS_DEFAULT_TIMEOUT=0.3
MODBUS_DEFAULT_POLL_INTERVAL=0.5
MODBUS_DEFAULT_AUTO_OFF_TIME=1.0
MODBUS_DEFAULT_RETRY_COUNT=3
MODBUS_DEFAULT_RETRY_DELAY=0.1

# ==============================================================================
# 센서 URL (DI 감지 시 호출할 URL)
# ==============================================================================
# 모든 장비 공통 URL
SENSOR_URL=http://localhost:5000/api/get_sensor

# 장비별 개별 URL을 사용하려면 DEVICE{N}_SENSOR_URL을 설정하세요
# 예: DEVICE1_SENSOR_URL=http://192.168.10.100/sensor


# ==============================================================================
# 장비 1 설정 (Lane1)
# ==============================================================================
DEVICE1_ENABLED=true
DEVICE1_NAME=Lane1
DEVICE1_HOST=192.168.10.101
# 선택사항: 아래 설정들은 전역 기본값을 사용하려면 주석 처리하세요
# DEVICE1_PORT=502
# DEVICE1_UNIT_ID=1
# DEVICE1_TIMEOUT=0.3
# DEVICE1_POLL_INTERVAL=0.5
# DEVICE1_AUTO_OFF_TIME=1.0
# DEVICE1_RETRY_COUNT=3
# DEVICE1_RETRY_DELAY=0.1
# DEVICE1_SENSOR_URL=http://localhost:5000/api/get_sensor


# ==============================================================================
# 장비 2 설정 (Lane2)
# ==============================================================================
DEVICE2_ENABLED=true
DEVICE2_NAME=Lane2
DEVICE2_HOST=192.168.10.102
# 선택사항: 필요 시 개별 설정 가능
# DEVICE2_PORT=502
# DEVICE2_UNIT_ID=1


# ==============================================================================
# 장비 3 설정 (Lane3)
# ==============================================================================
DEVICE3_ENABLED=true
DEVICE3_NAME=Lane3
DEVICE3_HOST=192.168.10.103
# 선택사항: 필요 시 개별 설정 가능
# DEVICE3_PORT=502
# DEVICE3_UNIT_ID=1


# ==============================================================================
# 장비 4 설정 (Lane4)
# ==============================================================================
DEVICE4_ENABLED=true
DEVICE4_NAME=Lane4
DEVICE4_HOST=192.168.10.104
# 선택사항: 필요 시 개별 설정 가능
# DEVICE4_PORT=502
# DEVICE4_UNIT_ID=1


# ==============================================================================
# 장비 5-8 설정 (추가 장비가 필요한 경우)
# ==============================================================================
# 최대 8대까지 확장 가능합니다. 필요 시 아래 설정을 활성화하세요.

# DEVICE5_ENABLED=true
# DEVICE5_NAME=Lane5
# DEVICE5_HOST=192.168.10.105

# DEVICE6_ENABLED=true
# DEVICE6_NAME=Lane6
# DEVICE6_HOST=192.168.10.106

# DEVICE7_ENABLED=true
# DEVICE7_NAME=Lane7
# DEVICE7_HOST=192.168.10.107

# DEVICE8_ENABLED=true
# DEVICE8_NAME=Lane8
# DEVICE8_HOST=192.168.10.108


# ==============================================================================
# 로깅 설정
# ==============================================================================
LOG_LEVEL=INFO
# 옵션: DEBUG, INFO, WARNING, ERROR, CRITICAL


# ==============================================================================
# 보안 설정 (프로덕션 환경)
# ==============================================================================
# CORS 허용 Origin (쉼표로 구분, 기본값: *)
# ALLOWED_ORIGINS=http://localhost:5000,http://192.168.10.100


# ==============================================================================
# 참고사항
# ==============================================================================
#
# 1. CIE-H14A 장비 설정:
#    - ezManager 도구로 Modbus TCP 활성화
#    - 각 장비에 고정 IP 할당
#    - Unit ID = 1 (모든 장비 동일 권장)
#
# 2. 네트워크 확인:
#    - ping 192.168.10.101
#    - ping 192.168.10.102
#    - ping 192.168.10.103
#    - ping 192.168.10.104
#
# 3. 테스트 환경 (시뮬레이터 사용 시):
#    - DEVICE1_HOST=127.0.0.1
#    - DEVICE1_PORT=5020
#    - DEVICE2_HOST=127.0.0.1
#    - DEVICE2_PORT=5021
#    - ...
#
# 4. 필수 항목:
#    - DEVICE{N}_ENABLED=true (필수)
#    - DEVICE{N}_HOST=xxx.xxx.xxx.xxx (필수)
#    - 나머지는 전역 기본값 사용 가능
#
# ==============================================================================
