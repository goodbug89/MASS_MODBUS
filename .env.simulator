# ==============================================================================
# Flask 설정
# ==============================================================================
FLASK_ENV=development
SECRET_KEY=dev-simulator-secret-key
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ==============================================================================
# 전역 Modbus 기본값 (개별 장비 설정이 없을 때 사용)
# ==============================================================================
MODBUS_DEFAULT_UNIT_ID=1
MODBUS_DEFAULT_TIMEOUT=0.3
MODBUS_DEFAULT_POLL_INTERVAL=0.5
MODBUS_DEFAULT_AUTO_OFF_TIME=1.0
MODBUS_DEFAULT_RETRY_COUNT=3
MODBUS_DEFAULT_RETRY_DELAY=0.1

# 센서 URL (DI 감지 시 호출할 URL - 모든 장비 공통)
SENSOR_URL=http://localhost:5000/api/get_sensor

# ==============================================================================
# 시뮬레이터용 장비 설정 (4대 모두 활성화, 로컬 포트 사용)
# ==============================================================================

# 장비 1 설정 (Lane1) - 시뮬레이터 포트 5020
DEVICE1_ENABLED=true
DEVICE1_NAME=Lane1
DEVICE1_HOST=127.0.0.1
DEVICE1_PORT=5020

# 장비 2 설정 (Lane2) - 시뮬레이터 포트 5021
DEVICE2_ENABLED=true
DEVICE2_NAME=Lane2
DEVICE2_HOST=127.0.0.1
DEVICE2_PORT=5021

# 장비 3 설정 (Lane3) - 시뮬레이터 포트 5022
DEVICE3_ENABLED=true
DEVICE3_NAME=Lane3
DEVICE3_HOST=127.0.0.1
DEVICE3_PORT=5022

# 장비 4 설정 (Lane4) - 시뮬레이터 포트 5023
DEVICE4_ENABLED=true
DEVICE4_NAME=Lane4
DEVICE4_HOST=127.0.0.1
DEVICE4_PORT=5023

# ==============================================================================
# 로깅 설정
# ==============================================================================
LOG_LEVEL=DEBUG
